#include <iomanip> 
#include <cmath> 
using namespace std; 
 
int main() { 
    double angka1; 
    double angka2; 
    double angka3; 
    double angka4; 
    double angka5; 
    
    cout << "Masukan Angka 1: "; 
    cin >> angka1; 
    cout << "Masukan Angka 2: "; 
    cin >> angka2; 
    cout << "Masukan Angka 3: "; 
    cin >> angka3; 
    cout << "Masukan Angka 4: "; 
